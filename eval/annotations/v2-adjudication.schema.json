{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixymon V2 blind-score adjudications",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "packId",
      "pairId",
      "side",
      "axis",
      "adjudicatorId",
      "resolvedScore",
      "reason",
      "adjudicatedAt"
    ],
    "additionalProperties": false,
    "properties": {
      "packId": { "type": "string", "minLength": 1 },
      "pairId": { "type": "string", "minLength": 1 },
      "side": { "enum": ["A", "B"] },
      "axis": {
        "enum": [
          "grounding",
          "clarity",
          "insight",
          "character",
          "memorability",
          "followWorthiness",
          "overall"
        ]
      },
      "adjudicatorId": { "type": "string", "pattern": "^adjudicator-[1-9][0-9]*$" },
      "resolvedScore": { "type": "integer", "minimum": 1, "maximum": 5 },
      "reason": { "type": "string", "minLength": 1 },
      "adjudicatedAt": { "type": "string", "format": "date-time" }
    }
  }
}
