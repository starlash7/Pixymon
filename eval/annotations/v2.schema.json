{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixymon V2 blind pair annotations",
  "type": "array",
  "items": { "$ref": "#/$defs/annotation" },
  "$defs": {
    "annotation": {
      "type": "object",
      "required": [
        "packId",
        "pairId",
        "reviewerId",
        "scores",
        "preference",
        "publishUnchanged",
        "pixymonIdentified",
        "hardVetoes",
        "reasonTags",
        "reviewedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "packId": { "type": "string", "minLength": 1 },
        "pairId": { "type": "string", "minLength": 1 },
        "reviewerId": { "enum": ["reader-1", "reader-2"] },
        "scores": { "$ref": "#/$defs/sideScores" },
        "preference": { "enum": ["A", "B", "tie"] },
        "publishUnchanged": { "$ref": "#/$defs/sideBooleans" },
        "pixymonIdentified": { "$ref": "#/$defs/sideBooleans" },
        "hardVetoes": { "$ref": "#/$defs/sideTags" },
        "reasonTags": { "$ref": "#/$defs/sideTags" },
        "editedText": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "A": { "type": "string", "minLength": 1 },
            "B": { "type": "string", "minLength": 1 }
          }
        },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "scores": {
      "type": "object",
      "required": [
        "grounding",
        "clarity",
        "insight",
        "character",
        "memorability",
        "followWorthiness",
        "overall"
      ],
      "additionalProperties": false,
      "properties": {
        "grounding": { "$ref": "#/$defs/score" },
        "clarity": { "$ref": "#/$defs/score" },
        "insight": { "$ref": "#/$defs/score" },
        "character": { "$ref": "#/$defs/score" },
        "memorability": { "$ref": "#/$defs/score" },
        "followWorthiness": { "$ref": "#/$defs/score" },
        "overall": { "$ref": "#/$defs/score" }
      }
    },
    "sideScores": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": false,
      "properties": {
        "A": { "$ref": "#/$defs/scores" },
        "B": { "$ref": "#/$defs/scores" }
      }
    },
    "sideBooleans": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": false,
      "properties": {
        "A": { "type": "boolean" },
        "B": { "type": "boolean" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sideTags": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": false,
      "properties": {
        "A": { "$ref": "#/$defs/tags" },
        "B": { "$ref": "#/$defs/tags" }
      }
    }
  }
}
