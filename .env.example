# Required for live LLM calls
ANTHROPIC_API_KEY=

# Optional Anthropic admin usage sync
ANTHROPIC_ADMIN_API_KEY=

# Required only when posting or reading X/Twitter live
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Optional market/news data
CRYPTOCOMPARE_API_KEY=

# Runtime mode
TEST_MODE=true
TEST_NO_EXTERNAL_CALLS=true
SCHEDULER_MODE=false
ACTION_MODE=observe
POST_PIPELINE_VERSION=v1
SOCIAL_SURFACES_ENABLED=false

# Loop and quota
DAILY_ACTIVITY_TARGET=20
DAILY_TARGET_TIMEZONE=Asia/Seoul
MAX_ACTIONS_PER_CYCLE=4
MIN_LOOP_MINUTES=25
MAX_LOOP_MINUTES=70

# Post and reply behavior
POST_GENERATION_MAX_ATTEMPTS=2
POST_MAX_CHARS=220
POST_MIN_LENGTH=20
ALLOW_FALLBACK_AUTO_PUBLISH=false
POST_MIN_INTERVAL_MINUTES=60
MAX_POSTS_PER_CYCLE=1
POST_LANGUAGE=ko
REPLY_LANGUAGE_MODE=match
REPLY_TONE_MODE=signal
REQUIRE_ONCHAIN_EVIDENCE=true
REQUIRE_CROSS_SOURCE_EVIDENCE=true
ENFORCE_KOREAN_POSTS=true

# Nutrient and trend gates
NUTRIENT_MIN_DIGEST_SCORE=0.5
NUTRIENT_MAX_INTAKE_PER_CYCLE=12
SENTIMENT_MAX_RATIO_24H=0.25
TREND_NEWS_MIN_SOURCE_TRUST=0.28
TREND_TWEET_MIN_SOURCE_TRUST=0.34
TREND_TWEET_MIN_SCORE=2.8
TREND_TWEET_MIN_ENGAGEMENT=4
TREND_TWEET_MAX_AGE_HOURS=24
TREND_TWEET_REQUIRE_ROOT_POST=true
TREND_TWEET_BLOCK_SUSPICIOUS_PROMO=true
TREND_KEYWORD_SEEDS=
TOPIC_MAX_SAME_TAG_24H=2
TOPIC_BLOCK_CONSECUTIVE_TAG=true
LANE_MAX_RATIO_JSON=
FOCUS_TOKEN_STOP_WORDS_EXTRA=
EVIDENCE_TOKEN_STOP_WORDS_EXTRA=

# Cost guards
X_API_COST_GUARD_ENABLED=true
X_API_DAILY_MAX_USD=0.1
X_API_ESTIMATED_READ_COST_USD=0.012
X_API_ESTIMATED_CREATE_COST_USD=0.01
X_API_DAILY_READ_REQUEST_LIMIT=
X_API_DAILY_CREATE_REQUEST_LIMIT=
X_MENTION_READ_MIN_INTERVAL_MINUTES=120
X_TREND_READ_MIN_INTERVAL_MINUTES=180
X_CREATE_MIN_INTERVAL_MINUTES=20

ANTHROPIC_COST_GUARD_ENABLED=true
ANTHROPIC_DAILY_MAX_USD=0.4
ANTHROPIC_DAILY_REQUEST_LIMIT=40
ANTHROPIC_DEGRADE_AT_UTILIZATION=0.7
ANTHROPIC_LOCAL_ONLY_AT_UTILIZATION=0.85
ANTHROPIC_PROMPT_CACHING_ENABLED=true
ANTHROPIC_CACHE_WRITE_MULTIPLIER=1.25
ANTHROPIC_CACHE_READ_MULTIPLIER=0.1
ANTHROPIC_USAGE_API_ENABLED=false
ANTHROPIC_USAGE_API_MIN_SYNC_MINUTES=5
ANTHROPIC_PRIMARY_INPUT_COST_PER_MILLION_USD=3
ANTHROPIC_PRIMARY_OUTPUT_COST_PER_MILLION_USD=15
ANTHROPIC_RESEARCH_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_RESEARCH_INPUT_COST_PER_MILLION_USD=0.8
ANTHROPIC_RESEARCH_OUTPUT_COST_PER_MILLION_USD=4

TOTAL_COST_GUARD_ENABLED=true
TOTAL_DAILY_MAX_USD=0.5

# Batch LLM workflow
ANTHROPIC_BATCH_ENABLED=false
ANTHROPIC_BATCH_MAX_REQUESTS=8
ANTHROPIC_BATCH_MAX_SYNC_BATCHES=3
ANTHROPIC_BATCH_MIN_SYNC_MINUTES=10

# Observability and local state
OBSERVABILITY_ENABLED=true
OBSERVABILITY_STDOUT_JSON=true
OBSERVABILITY_EVENT_LOG_PATH=data/metrics-events.ndjson
NARRATIVE_AUDIT_ENABLED=true
NARRATIVE_AUDIT_LOG_PATH=data/narrative-observation.ndjson
NARRATIVE_AUDIT_SUMMARY_PATH=data/narrative-phrase-audit.json
PIXYMON_DATA_DIR=data
# Required for ACTION_MODE=paper. Shared state is routed here automatically.
PIXYMON_PAPER_DATA_DIR=.paper-data
PIXYMON_LIVE_DATA_DIR=data
MEMORY_DATA_PATH=data/memory.json
POST_DISPATCH_LOCK_PATH=data/pixymon-post-dispatch.lock
POST_DISPATCH_STATE_PATH=data/pixymon-post-dispatch.json

# Pixymon V2 editorial queue (blank = under the active data directory)
EDITORIAL_EVENT_LOG_PATH=
# live = normal approval queue (does NOT authorize live X writes); shadow = isolated, never publishable
EDITORIAL_TRACKING_MODE=live
EDITORIAL_METRIC_LOG_PATH=
EDITORIAL_PUBLISH_LOCK_PATH=
EDITORIAL_REVIEWER_ID=operator
EDITORIAL_COLLECT_INTERVAL_MINUTES=360

# Character autonomy and safety
SOUL_MODE=true
SOFT_GATE_MODE=false
QUEST_MODE=true
AUTONOMY_MAX_BUDGET_UTILIZATION=0.92
AUTONOMY_RISK_BLOCK_SCORE=7
STATE_RECONCILE_ON_BOOT=true
ACTION_TWO_PHASE_COMMIT=true
CRASH_FLUSH_ON_EXCEPTION=true
SESSION_QUARANTINE_ON_PARSE_ERROR=true
TOOL_CALL_STRICT_VALIDATE=true

# Comma-separated debug scopes used by src/services/llm.ts
DEBUG=
